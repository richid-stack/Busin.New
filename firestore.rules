rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All data access goes through the OpenLobs server using the Firebase Admin SDK,
    // which bypasses these rules and enforces per-user ownership itself.
    // Browsers must never read or write Firestore directly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
