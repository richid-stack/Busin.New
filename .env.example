GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
COMPOSIO_API_KEY=
# Firebase Admin (server): on Google Cloud the attached service account is used automatically.
# Locally, run `gcloud auth application-default login` or set GOOGLE_APPLICATION_CREDENTIALS.
# SESSION_SECRET is REQUIRED in production (32+ random characters).
# Comma-separated extra origins allowed to call the API from a browser (same-origin is always allowed).
# CORS_ALLOWED_ORIGINS=
# Set to false to require sign-in for chat. Default allows anonymous (rate-limited) chats.
# ALLOW_ANONYMOUS_CHAT=true
