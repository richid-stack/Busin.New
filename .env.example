GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
COMPOSIO_API_KEY=
# Firebase Admin (server): on Google Cloud the attached service account is used automatically.
# Locally, run `gcloud auth application-default login` or set GOOGLE_APPLICATION_CREDENTIALS.
# SESSION_SECRET is REQUIRED in production (32+ random characters).
# Comma-separated extra origins allowed to call the API from a browser (same-origin is always allowed).
# CORS_ALLOWED_ORIGINS=
# Chat requires sign-in. Set to true only to allow anonymous (rate-limited) chats, e.g. local demos.
# ALLOW_ANONYMOUS_CHAT=false
# Number of reverse proxies in front of the app (Cloud Run = 1, the default). Rate limits read the
# client address from the right of X-Forwarded-For using this count, so spoofed values are ignored.
# TRUSTED_PROXY_HOPS=1
# Web tools. Every key is optional: without any, search falls back to DuckDuckGo and pages are
# read by the built-in reader. Add a key to switch a provider on; paid plans can wait until launch.
# FIRECRAWL_API_KEY=       # page reading (JavaScript sites) and search
# PARALLEL_API_KEY=        # search
# TAVILY_API_KEY=          # search
# Order providers are tried in (default: parallel,tavily,firecrawl,duckduckgo)
# SEARCH_PROVIDERS=parallel,tavily,firecrawl,duckduckgo
# Scheduled workflows. Without CRON_SECRET the timer endpoint (/api/cron/workflows) does not exist.
# Use 16+ random characters and send it as `Authorization: Bearer <secret>` from Cloud Scheduler.
# CRON_SECRET=
# Shortest gap allowed between runs of a scheduled workflow, in minutes (default 15).
# SCHEDULE_MIN_MINUTES=15
# MCP servers. Tokens for people's own MCP servers are encrypted with this key (16+ random characters).
# Falls back to SESSION_SECRET when unset. Changing it makes stored tokens unreadable.
# SECRETS_KEY=
# Optional: only allow MCP servers on these hosts (comma-separated; a leading "." allows subdomains).
# MCP_ALLOWED_HOSTS=
