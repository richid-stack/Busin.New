# The screenshot worker for OpenLobs' visual inspection. Build: `gcloud run deploy openlobs-inspector --source . --dockerfile Dockerfile.inspector`
# (or `docker build -f Dockerfile.inspector .`). The base image already contains Chromium; its version must match playwright-core below.
FROM mcr.microsoft.com/playwright:v1.56.0-noble
WORKDIR /app
RUN npm init -y >/dev/null && npm install --no-audit --no-fund playwright-core@1.56.0 tsx@4
# Only the two files the worker needs, so a change elsewhere in the app does not rebuild this image.
COPY server/utils/netSafety.ts ./server/utils/netSafety.ts
COPY server/services/inspect/browser.ts ./server/services/inspect/browser.ts
COPY inspector/server.ts ./inspector/server.ts
ENV NODE_ENV=production PORT=8080
USER pwuser
EXPOSE 8080
CMD ["npx", "tsx", "inspector/server.ts"]
